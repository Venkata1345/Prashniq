# Who conducts the interview: groq (free tier), anthropic (Claude), openai,
# or fake (stubbed, no key needed). Each provider has a sane default model
# (groq -> openai/gpt-oss-120b, openai -> gpt-4o-mini, anthropic -> claude-opus-5).
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_EFFORT=high
LLM_TIMEOUT_SECONDS=60
LLM_STRUCTURED_ATTEMPTS=3

# Free at console.groq.com (30 req/min, 6k tokens/min, no card needed).
# GROQ_API_KEY=gsk_...
# Leave unset to let the SDK resolve ANTHROPIC_API_KEY or an `ant auth login` profile.
# ANTHROPIC_API_KEY=sk-ant-...

# --- Retrieval -------------------------------------------------------------
# `fake` uses deterministic local vectors and needs no key.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# OPENAI_API_KEY=sk-...

# With DATABASE_URL set, interviews, contexts, skill profiles AND vectors are
# durable (Alembic migrations run at startup; needs `docker compose up -d db`).
# Without it, everything is in-process and lost on restart.
# DATABASE_URL=postgresql+asyncpg://interview:interview@localhost:5432/interview
VECTOR_STORE=auto
SEED_KNOWLEDGE_BASE=true
# Calibrated against text-embedding-3-small (scripts/live_smoke.py, 2026-08-24):
# knowledge notes match true topics at 0.46+, noise reaches 0.31; short resume
# claims live in a lower band. RETRIEVAL_MIN_SCORE is the fallback.
RETRIEVAL_MIN_SCORE=0.15
KNOWLEDGE_MIN_SCORE=0.35
CLAIM_MIN_SCORE=0.25

LOG_LEVEL=INFO
